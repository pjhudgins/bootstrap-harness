:446,"output_tokens":0},"rs_04ef62e5ea280255016abab52ef8f887d29931784915a71e5c":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":10,"output_tokens":0},"ctc_04ef62e5ea280255016abab52f40cc87d2b3a5a24884973c51":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":29,"output_tokens":0},"ctco_01a0e953-c144-7c23-a5be-add1dabc0a58":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"content":[{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":860,"output_tokens":0}],"input_tokens":880,"output_tokens":0},"ctc_04ef62e5ea280255016abab530cbb887d2b0bafe1b63b08f81":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":2,"output_tokens":42}}},"input_tokens":6859,"input_tokens_details":"[REDACTED]","output_tokens":42,"output_tokens_details":"[REDACTED]","total_tokens":6901}}},"emittedAtMs":1790620977237},"text_entries":[]}}
