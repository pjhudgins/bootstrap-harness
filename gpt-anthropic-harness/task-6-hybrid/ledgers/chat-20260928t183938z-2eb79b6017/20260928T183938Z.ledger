{"ts":"2026-09-28T18:39:48.809Z","author":"harness","name":"harness/00000020","body":{"seq":20,"kind":"onboarding_complete","actor":"agent.claude.governor","path":"origins/onboarding_1.12.md"}}
{"ts":"2026-09-28T18:39:48.809Z","author":"harness","name":"harness/00000020","tag":"harness"}
