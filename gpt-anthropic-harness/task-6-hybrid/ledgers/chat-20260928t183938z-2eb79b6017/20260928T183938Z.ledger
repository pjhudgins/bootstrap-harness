{"ts":"2026-09-28T18:40:11.147Z","author":"harness","name":"harness/00000112","body":{"seq":112,"kind":"onboarding_complete","actor":"agent.gpt.owner-1","path":"origins/onboarding_1.12.md"}}
{"ts":"2026-09-28T18:40:11.147Z","author":"harness","name":"harness/00000112","tag":"harness"}
