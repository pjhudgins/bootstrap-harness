{"ts":"2026-09-28T18:40:11.174Z","author":"harness","name":"harness/00000117","body":{"seq":117,"kind":"codex_receive","actor":"agent.gpt.owner-1","turn":"565dd70e52b2448ba2c55dd4b87ee6b5","payload":{"method":"rawResponse/completed","params":{"threadId":"01a0e951-2bca-7e03-8a23-4e240eb824aa","turnId":"01a0e951-2f76-7000-a4b8-283b73410671","responseId":"resp_07652d9bf18b858b016abab489f03487d2a73fddc91f18d5ef","usage":{"totalTokens":6874,"inputTokens":6832,"cachedInputTokens":"[REDACTED]","cacheWriteInputTokens":"[REDACTED]","outputTokens":42,"reasoningOutputTokens":"[REDACTED]"},"usageMetadata":{"amount":null,"metadata":{"attribution":{"items":{"at_6aaa7e6a-f22c-5b02-ad71-12a46375933d":{"cache_write_tokens":"[REDACTED]","cached_tokens":3710,"input_tokens":3710,"output_tokens":0},"msg_56259ac8-f67f-5822-ad54-9e7219d81991":{"cache_write_tokens":"[REDACTED]","cached_tokens":922,"content":[{"cache_write_tokens":"[REDACTED]","cached_tokens":922,"input_tokens":922,"output_tokens":0}],"input_tokens":922,"output_tokens":0},"msg_01a0e951-3040-7740-bb0b-b6ed5d68d513":{"cache_write_tokens":"[REDACTED]","cached_tokens":822,"content":[{"cache_write_tokens":"[REDACTED]","cached_tokens":16,"input_tokens":16,"output_tokens":0},{"cache_write_tokens":"[REDACTED]","cached_tokens":559,"input_tokens":559,"output_tokens":0},{"cache_write_tokens":"[REDACTED]","cached_tokens":68,"input_tokens":68,"output_tokens":0},{"cache_write_tokens":"[REDACTED]","cached_tokens":179,"input_tokens":179,"output_tokens":0}],"input_tokens":822,"output_tokens":0},"msg_01a0e951-3040-7740-bb0b-b6f6ffcb3910":{"cache_write_tokens":"[REDACTED]","cached_tokens":38,"content":[{"cache_write_tokens":"[REDACTED]","cached_tokens":38,"input_tokens":38,"output_tokens":0}],"input_tokens":38,"output_tokens":0},"msg_01a0e951-3048-77c0-b548-9eba158a8b57":{"cache_write_tokens":"[REDACTED]","cached_tokens":268,"content":[{"cache_write_tokens":"[REDACTED]","cached_tokens":268,"input_tokens":412,"output_tokens":0}],"input_tokens":412,"output_tokens":0},"rs_07652d9bf18b858b016abab488a65487d28e4aec556ffcf71d":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":17,"output_tokens":0},"ctc_07652d9bf18b858b016abab489138c87d2a10744f680cf8744":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":29,"output_tokens":0},"ctco_01a0e951-386c-7511-b405-d082552ba50e":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"content":[{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":860,"output_tokens":0}],"input_tokens":880,"output_tokens":0},"ctc_07652d9bf18b858b016abab48ac17087d2be3d48efb75975c3":{"cache_write_tokens":"[REDACTED]","cached_tokens":0,"input_tokens":2,"output_tokens":42}}},"input_tokens":6832,"input_tokens_details":"[REDACTED]","output_tokens":42,"output_tokens_details":"[REDACTED]","total_tokens":6874}}},"emittedAtMs":1790620811174},"text_entries":[]}}
