{"ts":"2026-09-25T19:25:42.217Z","author":"harness","name":"harness/00000021","body":{"seq":21,"kind":"onboarding_complete","actor":"agent.claude.test-pilot","path":"origins/onboarding_1.12.md"}}
{"ts":"2026-09-25T19:25:42.218Z","author":"harness","name":"harness/00000021","tag":"harness"}
