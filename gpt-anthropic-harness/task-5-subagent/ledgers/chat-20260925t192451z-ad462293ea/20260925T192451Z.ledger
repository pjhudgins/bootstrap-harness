ding_1.11.md\", \"path\": \"origins/onboarding_1.11.md\", \"type\": \"file\"}, {\"name\": \"onboarding_1.12.md\", \"path\": \"origins/onboarding_1.12.md\", \"type\": \"file\"}, {\"name\": \"peer_learning_primer_v1.md\", \"path\": \"origins/peer_learning_primer_v1.md\", \"type\": \"file\"}, {\"name\": \"persistent_testbed.md\", \"path\": \"origins/persistent_testbed.md\", \"type\": \"file\"}, {\"name\": \"procedure_acquisition_history\", \"path\": \"origins/procedure_acquisition_history\", \"type\": \"directory\"}, {\"name\": \"social_ai_and_institutional_alignment_primer_v1.md\", \"path\": \"origins/social_ai_and_institutional_alignment_primer_v1.md\", \"type\": \"file\"}, {\"name\": \"virtue_methodology.md\", \"path\": \"origins/virtue_methodology.md\", \"type\": \"file\"}, {\"name\": \"virtues.md\", \"path\": \"origins/virtues.md\", \"type\": \"file\"}], \"total\": 24, \"next_offset\": null}"}],"error":null}}
