{"ts":"2026-09-28T18:47:02.191Z","author":"gpt-codex-harness","name":"harness/events/00000288","body":{"sequence":288,"kind":"receive","actor":"owner-0001","data":{"method":"rawResponse/completed","params":{"threadId":"01a0e957-7428-7671-a6ab-74611f122b9c","turnId":"01a0e957-7678-7873-8fc1-29a1ef26f34a","responseId":"resp_03254840f7d5d9e5016abab623ff9887d29ab6387c77dbab97","usage":{"totalTokens":7264,"inputTokens":7228,"cachedInputTokens":0,"cacheWriteInputTokens":0,"outputTokens":36,"reasoningOutputTokens":0},"usageMetadata":{"amount":null,"metadata":{"attribution":{"items":{"at_812294e5-b843-5796-b47c-f6edfc062657":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":4050,"output_tokens":0},"msg_05834981-a338-551a-9fbb-0e72adb3a2b9":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":1849,"output_tokens":0}],"input_tokens":1849,"output_tokens":0},"msg_01a0e957-7a46-76d2-acc5-e2b189259d17":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":29,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":559,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":68,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":179,"output_tokens":0}],"input_tokens":835,"output_tokens":0},"msg_01a0e957-7a46-76d2-acc5-e2cf990c6f65":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":38,"output_tokens":0}],"input_tokens":38,"output_tokens":0},"msg_01a0e957-7a4c-7f11-a762-733b2359207e":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":454,"output_tokens":0}],"input_tokens":454,"output_tokens":0},"ctc_03254840f7d5d9e5016abab625788087d2b6c2baf40bed7619":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":36}}},"input_tokens":7228,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":0},"output_tokens":36,"output_tokens_details":{"reasoning_tokens":0},"total_tokens":7264}}},"emittedAtMs":1790621222172}}}
{"ts":"2026-09-28T18:47:02.192Z","author":"gpt-codex-harness","name":"harness/events/00000289","tag":"harness"}
