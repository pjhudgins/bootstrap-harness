{"ts":"2026-09-25T21:20:48.045Z","author":"gpt-codex-harness","name":"harness/events/00000222","body":{"sequence":222,"kind":"onboarding_complete","actor":"child-0001","data":{"path":"origins/onboarding_1.12.md","sha256":"0922102f1bc74657919b91834135322e71e9004014b025187a52b6c55a054145"}}}
