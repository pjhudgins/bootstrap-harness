{"ts":"2026-09-25T21:20:48.094Z","author":"gpt-codex-harness","name":"harness/events/00000226","body":{"sequence":226,"kind":"receive","actor":"child-0001","data":{"method":"rawResponse/completed","params":{"threadId":"01a0da71-15a5-7870-9d6e-1e6f81b617ee","turnId":"01a0da71-18df-79a1-a402-8e05940d3ffb","responseId":"resp_04b09dabb8269b6d016ab6e5ae8a3487d2b044f28ca7d25e42","usage":{"totalTokens":5634,"inputTokens":5577,"cachedInputTokens":4608,"cacheWriteInputTokens":0,"outputTokens":57,"reasoningOutputTokens":17},"usageMetadata":{"amount":null,"metadata":{"attribution":{"items":{"msg_01a0da71-1c6a-7e72-ad91-bf5f4f3da8a4":{"cache_write_tokens":0,"cached_tokens":1210,"content":[{"cache_write_tokens":0,"cached_tokens":29,"input_tokens":29,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":1112,"input_tokens":1112,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":69,"input_tokens":69,"output_tokens":0}],"input_tokens":1210,"output_tokens":0},"msg_01a0da71-1c6a-7e72-ad91-bf6a5f01cbe8":{"cache_write_tokens":0,"cached_tokens":4,"content":[{"cache_write_tokens":0,"cached_tokens":4,"input_tokens":38,"output_tokens":0}],"input_tokens":38,"output_tokens":0},"msg_01a0da71-1c72-7fa0-a327-f5feaf8da4b0":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":238,"output_tokens":0}],"input_tokens":238,"output_tokens":0},"rs_04b09dabb8269b6d016ab6e5a9ff6087d2bea068c3968cfbf5":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":197,"output_tokens":0},"fc_04b09dabb8269b6d016ab6e5adb6d487d286045c1c250d4048":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":33,"output_tokens":0},"fco_01a0da71-3051-7cb0-9e77-dbd24610f93e":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":465,"output_tokens":0}],"input_tokens":465,"output_tokens":0},"rs_04b09dabb8269b6d016ab6e5aefa7887d2aa7fb86597373012":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":17},"fc_04b09dabb8269b6d016ab6e5af7c0087d288573e3c99bd6db4":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":40}},"request_fields":{"tools":{"cache_write_tokens":0,"cached_tokens":1911,"input_tokens":1911,"output_tokens":0},"instructions":{"cache_write_tokens":0,"cached_tokens":1483,"input_tokens":1483,"output_tokens":0}}},"input_tokens":5577,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":4608},"output_tokens":57,"output_tokens_details":{"reasoning_tokens":17},"total_tokens":5634}}},"emittedAtMs":1790371248092}}}
{"ts":"2026-09-25T21:20:48.096Z","author":"gpt-codex-harness","name":"harness/events/00000227","tag":"harness"}
