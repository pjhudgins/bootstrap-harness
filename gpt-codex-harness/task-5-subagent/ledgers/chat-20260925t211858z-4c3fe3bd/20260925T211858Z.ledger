{"ts":"2026-09-25T21:19:56.635Z","author":"gpt-codex-harness","name":"harness/events/00000060","body":{"sequence":60,"kind":"receive","actor":"main","data":{"method":"rawResponse/completed","params":{"threadId":"01a0da6f-9ea7-7fa2-aa30-fe29a28f980b","turnId":"01a0da70-59e2-7dd0-8d6d-a4d5a57f8bad","responseId":"resp_0178cd5ae8e436a2016ab6e57a7e6887d2820bb72b24b3f63a","usage":{"totalTokens":7368,"inputTokens":7336,"cachedInputTokens":6656,"cacheWriteInputTokens":0,"outputTokens":32,"reasoningOutputTokens":0},"usageMetadata":{"amount":null,"metadata":{"attribution":{"items":{"at_46fa58ac-6842-5542-a162-85e8f3aace73":{"cache_write_tokens":0,"cached_tokens":4208,"input_tokens":4208,"output_tokens":0},"msg_baeaab82-332b-5dd8-898f-6eee504f9e61":{"cache_write_tokens":0,"cached_tokens":1469,"content":[{"cache_write_tokens":0,"cached_tokens":1469,"input_tokens":1469,"output_tokens":0}],"input_tokens":1469,"output_tokens":0},"msg_01a0da70-5b80-7550-a316-d14290687edc":{"cache_write_tokens":0,"cached_tokens":835,"content":[{"cache_write_tokens":0,"cached_tokens":29,"input_tokens":29,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":559,"input_tokens":559,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":68,"input_tokens":68,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":179,"input_tokens":179,"output_tokens":0}],"input_tokens":835,"output_tokens":0},"msg_01a0da70-5b80-7550-a316-d153a19a8cd7":{"cache_write_tokens":0,"cached_tokens":38,"content":[{"cache_write_tokens":0,"cached_tokens":38,"input_tokens":38,"output_tokens":0}],"input_tokens":38,"output_tokens":0},"msg_01a0da70-5b89-7110-a77d-eabcb15f2e36":{"cache_write_tokens":0,"cached_tokens":106,"content":[{"cache_write_tokens":0,"cached_tokens":106,"input_tokens":279,"output_tokens":0}],"input_tokens":279,"output_tokens":0},"ctc_0178cd5ae8e436a2016ab6e57944f887d28c846ecfde626521":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":28,"output_tokens":0},"ctco_01a0da70-64cc-7c40-95e0-26ed71386729":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":457,"output_tokens":0}],"input_tokens":477,"output_tokens":0},"ctc_0178cd5ae8e436a2016ab6e57bd8e887d2bf4a85213995dc15":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":32}}},"input_tokens":7336,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":6656},"output_tokens":32,"output_tokens_details":{"reasoning_tokens":0},"total_tokens":7368}}},"emittedAtMs":1790371196632}}}
{"ts":"2026-09-25T21:19:56.636Z","author":"gpt-codex-harness","name":"harness/events/00000061","tag":"harness"}
