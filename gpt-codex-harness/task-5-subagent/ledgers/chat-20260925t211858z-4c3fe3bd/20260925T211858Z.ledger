bled":false},{"name":"responses_websockets","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"responses_websockets_v2","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"remote_compaction_v2","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"compaction_image_budget","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"retain_client_developer_messages","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"use_agent_identity","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"workspace_dependencies","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true}],"nextCursor":null}}}}
