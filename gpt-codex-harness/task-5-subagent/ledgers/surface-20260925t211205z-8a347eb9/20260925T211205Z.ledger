{"ts":"2026-09-25T21:12:05.898Z","author":"gpt-codex-harness","name":"harness/events/00000040","body":{"sequence":40,"kind":"onboarding_complete","actor":"main","data":{"path":"origins/onboarding_1.12.md","sha256":"0922102f1bc74657919b91834135322e71e9004014b025187a52b6c55a054145"}}}
{"ts":"2026-09-25T21:12:05.900Z","author":"gpt-codex-harness","name":"harness/events/00000041","tag":"harness"}
{"ts":"2026-09-25T21:12:05.900Z","author":"gpt-codex-harness","name":"harness/events/00000041","tag":"log-python_tool"}
