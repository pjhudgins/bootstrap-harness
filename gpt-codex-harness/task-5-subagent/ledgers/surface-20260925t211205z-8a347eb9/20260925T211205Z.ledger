hread_context","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"guardian_reuse_parent_compaction","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"guardian_enhanced_node_repl_transcripts","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"guardian_node_repl_transcript_images","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"guardianv2","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"guardian_ext","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"goals","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"token_budget","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"context_management","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"rollout_budget","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"reasoning_effort_override","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"current_time_reminder","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"collaboration_modes","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"tool_call_mcp_elicitation","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"auth_elicitation","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"bedrock_setup_wizard","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"personality","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"artifact","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"fast_mode","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"step_model_switching","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"realtime_conversation","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"remote_control","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"image_detail_original","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"tui_app_server","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"prevent_idle_sleep","stage":"beta","displayName":"Prevent sleep while running","description":"Keep your computer awake while Codex is running a thread.","announcement":"NEW: Prevent sleep while running is now available in /experimental.","enabled":false,"defaultEnabled":false},{"name":"workspace_owner_usage_nudge","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"responses_websockets","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"responses_websockets_v2","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"remote_compaction_v2","stage":"removed","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"compaction_image_budget","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true},{"name":"retain_client_developer_messages","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"use_agent_identity","stage":"underDevelopment","displayName":null,"description":null,"announcement":null,"enabled":false,"defaultEnabled":false},{"name":"workspace_dependencies","stage":"stable","displayName":null,"description":null,"announcement":null,"enabled":true,"defaultEnabled":true}],"nextCursor":null}}}}
