s":199,"output_tokens_details":{"reasoning_tokens":160},"total_tokens":11288}}},"emittedAtMs":1790364540921}}}
{"ts":"2026-09-25T19:29:00.923Z","author":"harness:claude-codex-harness/task-5-subagent","name":"harness/20260925T192816Z/000301.recv","tag":"harness"}
