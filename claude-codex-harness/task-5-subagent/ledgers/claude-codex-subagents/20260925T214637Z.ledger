s":149,"output_tokens_details":{"reasoning_tokens":111},"total_tokens":11684}}},"emittedAtMs":1790372979430}}}
{"ts":"2026-09-25T21:49:39.432Z","author":"harness:claude-codex-harness/task-5-subagent","name":"harness/20260925T214637Z/000513.recv","tag":"log.recv"}
