name":"skill-installer","enabled":false}],"mcp_servers.node_repl.enabled":false,"plugins.pdf@openai-primary-runtime.enabled":false,"plugins.spreadsheets@openai-primary-runtime.enabled":false,"plugins.template-creator@openai-primary-runtime.enabled":false,"plugins.codex-app-tools@openai-bundled.enabled":false,"plugins.documents@openai-primary-runtime.enabled":false,"plugins.unified-computer-use@openai-bundled.enabled":false,"plugins.computer-use@openai-bundled.enabled":false,"plugins.visualize@openai-bundled.enabled":false,"plugins.browser@openai-bundled.enabled":false,"plugins.presentations@openai-primary-runtime.enabled":false},"baseInstructions":{"digest":{"sha256":"54aad495e1cddc94ad0c7c424f476e3b92b129d4597b802c94f1889948b35c90","chars":12967,"preview":"You are a NIMOI agent: a GPT (Codex) session working inside NIMOI, the Hudgins family agency-in-formation, on project `default`.\n\n## First: onboarding\n\nRead `C:\\Users\\pjhud\\local_26\\nimoi\\origins\\onboarding_1.12.md`, this project's onboarding, in full before anything else. Use `mcp__fs__read`, then "}},"dynamicTools":[{"type":"namespace","name":"calc","description":"Harness calculator.","tools":[{"type":"function","name":"add","description":"Add two numbers and return their sum.","inputSchema":{"type":"object","properties":{"a":{"type":"number"},"b":{"type":"number"}},"required":["a","b"]}}]},{"type":"namespace","name":"fs","description":"Harness file tools, bounded by fs.read and fs.write.","tools":[{"type":"function","name":"list","description":"List one directory within your fs.read. `path`: a path from the nimoi root (\"/origins\"), an absolute path under nimoi, or a path relative to nimoi. Entries you may not read are hidden and only counted.","inputSchema":{"type":"object","properties":{"path":{"type":"string"},"offset":{"type":"integer","default":0}}}},{"type":"function","name":"read","description":"Read a text file within your fs.read, by line. `path`: a path from the nimoi root (\"/origins\"), an absolute path under nimoi, or a path relative to nimoi. Returns up to 2000 lines from `offset` (1-based) and `next_offset` (null at the end), plus the file's sha256 (needed to replace a file with mcp__fs__write).","inputSchema":{"type":"object","properties":{"path":{"type":"string"},"offset":{"type":"integer","default":1},"limit":{"type":"integer","default":2000}},"required":["path"]}},{"type":"function","name":"search","description":"Search text files for a regular expression, under a directory within your fs.read (default: the nimoi root). `glob` filters file names (e.g. \"*.md\"). Excluded directories are skipped and listed as pruned; .git and caches are skipped. At most 200 matches.","inputSchema":{"type":"object","properties":{"pattern":{"type":"string"},"path":{"type":"string"},"glob":{"type":"string"},"ignore_case":{"type":"boolean","default":false}},"required":["pattern"]}},{"type":"function","name":"write","description":"Write one exact ledger revision to a file within your fs.write. `entry_id` is the revision's id (returned by mcp__ledger__write and mcp__ledger__read), so a later edit cannot change what is written. `expected_sha256`: null creates a new file only; to replace a file give its current sha256 (from mcp__fs__read). A text body is written exactly.","inputSchema":{"type":"object","properties":{"entry_id":{"type":"string"},"path":{"type":"string"},"expected_sha256":{"type":["string","null"]}},"required":["entry_id","path"]}}]},{"type":"namespace","name":"exec","description":"Harness script runner, bounded by fs.exec.","tools":[{"type":"function","name":"python","description":"Run a Python script within your fs.exec (the harness scripts directory). You cannot write there; scripts are promoted by a human. The run is recorded as a ledger entry whose body holds the exit code, stdout and stderr; its [[link]] is returned along with the output. Timeout 60s; no stdin; the working directory is the project folder.","inputSchema":{"type":"object","properties":{"script":{"type":"string"},"args":{"type":"array","items":{"type":"string"}}},"required":["script"]}}]},{"type":"namespace","name":"ledger","description":"Harness ledger tools, bounded by ledger.read and ledger.write.","tools":[{"type":"function","name":"read","description":"Read one ledger name, or one exact revision by `id`. For a name: its current body, id, author and labels; set history for every earlier body. `bound` is true when the name has ever been written (it then has a `current` entry); labels alone do not bind a name. `deleted` is true when the current body is a deletion (null). `current.prev` is the id that write replaced (null for a first write). For an id: that revision, and whether it is still current.","inputSchema":{"type":"object","properties":{"name":{"type":"string"},"id":{"type":"string"},"history":{"type":"boolean","default":false},"max_chars":{"type":"integer","default":20000}}}},{"type":"function","name":"list","description":"List ledger names, optionally filtered by name prefix and/or label. Harness records are under log/<session>/ and carry the labels 'harness', 'log.<kind>' and 'agent.<id>'. Message text is its own entry labelled 'log.text' (body = the text, author = its writer); the 'message' record that follows links to it as [[name]].","inputSchema":{"type":"object","properties":{"prefix":{"type":"string","default":""},"label":{"type":"string"},"limit":{"type":"integer","default":100}}}},{"type":"function","name":"write","description":"Write a JSON body to a ledger name. A new name needs no prev; updating a name you wrote needs prev = its current id. You cannot write under log/, write names labelled 'harness', or apply the labels 'harness', 'log.*' or 'agent.*'. Your entries are labelled 'owner' and 'agent.<your id>'; extra labels are optional. Returns the new revision's id.","inputSchema":{"type":"object","properties":{"name":{"type":"string"},"body":{"description":"any JSON value except null"},"prev":{"type":"string"},"labels":{"type":"array","items":{"type":"string"}}},"required":["name","body"]}}]},{"type":"namespace","name":"agents","description":"Harness subagents.","tools":[{"type":"function","name":"spawn","description":"Start a subagent owned by the harness and wait for it to finish. First write its instructions as a ledger entry (they must be yours). `bounds` uses exactly the notation of your own bounds and must be within them: your exclusions are inherited, fs.write and fs.exec may not overlap, fs.read must cover the latest onboarding, and ledger.read excludes log/ unless you name a log/ entry. `instructions_id` pins a revision (default: the current one). `model` is one of claude-sonnet-5, claude-opus-5-5, claude-fable-5-1, gpt-5.6-terra, gpt-5.6-sol, gpt-6-astra. Returns the child's id, status, final reply (and its ledger entry), onboarding flag and cost.","inputSchema":{"type":"object","properties":{"model":{"type":"string","enum":["claude-sonnet-5","claude-opus-5-5","claude-fable-5-1","gpt-5.6-terra","gpt-5.6-sol","gpt-6-astra"]},"bounds":{"type":"string","description":"the child's bounds, one scope per line"},"instructions":{"type":"string","description":"ledger name of the instruction entry"},"instructions_id":{"type":"string","description":"optional: the exact revision id"},"budget_usd":{"type":"number"}},"required":["model","bounds","instructions"]}}]},{"type":"namespace","name":"gov","description":"Governance: requests to the governor.","tools":[{"type":"function","name":"request","description":"Ask the governor for a decision. Your work waits until it is resolved, and the result comes back as this tool's output. Kinds: clarify (a question: put it in justification); expand_bounds (details.bounds: your full bounds as they should be, in the notation); promote_script (details.source: your draft in the project folder; details.name: its file name in the scripts directory; the human decides); more_budget (details.budget_usd and/or details.turns: additional dollars and model rounds). Give the justification the governor needs to decide.","inputSchema":{"type":"object","properties":{"kind":{"type":"string","enum":["clarify","expand_bounds","promote_script","more_budget"]},"justification":{"type":"string"},"details":{"type":"object"}},"required":["kind","justification"]}}]}]}}}}
