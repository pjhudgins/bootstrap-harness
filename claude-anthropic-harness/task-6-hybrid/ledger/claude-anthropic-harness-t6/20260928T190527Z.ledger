{"ts":"2026-09-28T19:05:33.198Z","author":"harness:claude-anthropic-harness/task-6-hybrid","name":"log/20260928T190527Z/000030","body":{"kind":"codex_restrictions","agent":"pilot","turn":0,"thread_id":"01a0e968-76e8-7441-97ad-022ff8d48568","model":"gpt-5.6-sol","provider":"openai","sandbox":{"type":"readOnly","networkAccess":false},"approval_policy":"untrusted","multi_agent_mode":"explicitRequestOnly","instruction_sources":[],"exec_host":true,"reasoning_effort":"medium","service_tier":"default","disabled_plugin_ids":[],"stays_on":["unified_exec"],"runtime_calls_permitted":["exec","functions.exec","functions.request_user_input","functions.request_user_input_async","functions.wait","request_user_input","request_user_input_async","wait"],"items_permitted":["agentMessage","contextCompaction","dynamicToolCall","reasoning","userMessage"],"caveat":"Codex's JavaScript exec host stays on: this model reaches harness tools only from inside exec (rules.md 5g). Shell, patch, native delegation, MCP, apps, web and browser tools are requested off, and there is no execution environment. Approval requests are declined. Raw-call and item monitoring stops the agent after the fact: detection, not prevention."}}
